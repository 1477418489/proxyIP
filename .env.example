# Local service. Environment variables override values in this file.
CFPROXY_HOST=127.0.0.1
CFPROXY_PORT=8000
# Docker Compose host port only; the container always listens on port 8000.
# Use 8001 if the Windows/local service already uses 8000.
CFPROXY_HTTP_PORT=8000
CFPROXY_DB=data/cfproxy.sqlite3

# Optional DB-IP Country Lite MMDB file path. Empty uses the SQLite directory:
# dbip-country-lite.mmdb (Docker default: /data/dbip-country-lite.mmdb).
# The database is downloaded only when requested in the UI/API, not at startup.
CFPROXY_GEO_DB=

# Optional on loopback; required for Docker or any non-loopback bind.
# Use at least 16 characters; generate a random value with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CFPROXY_TOKEN=

# Optional HTTP proxy for source downloads and GeoIP database updates.
# Direct by default: enable use_proxy for each request. No HTTP_PROXY detection.
# Candidate local/Worker probes do not use this proxy.
# Format: http://host:port or http://user:password@host:port (port required).
# Example for a local HTTP/Mixed port: http://127.0.0.1:7890
# 127.0.0.1 means the backend machine; inside Docker it means the container.
# Docker Desktop host proxy: http://host.docker.internal:7890
CFPROXY_FETCH_PROXY=

# Optional Worker probe. Set both values or leave both empty.
# The URL must be the HTTPS root of your deployed Worker.
# Use a separate random token (at least 32 characters) matching PROBE_TOKEN.
CFPROXY_WORKER_URL=
CFPROXY_WORKER_TOKEN=
